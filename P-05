#include <stdio.h>

int n;
int weights[20];
int target;
int current_sol[20];
int sol_count = 0;

// Arrays to store solutions for reverse order printing
int stored_sols[1000][20];
int stored_lens[1000];

void subset_sum(int index, int current_sum, int sol_len) {
    // Base Case: If the target sum is reached
    if (current_sum == target) {
        stored_lens[sol_count] = sol_len;
        for (int i = 0; i < sol_len; i++) {
            stored_sols[sol_count][i] = current_sol[i];
        }
        sol_count++;
        return;
    }
    
    // Pruning/Base Case
    if (index == n || current_sum > target) {
        return;
    }
    
    // Choice 1: Include the current element
    current_sol[sol_len] = weights[index];
    subset_sum(index + 1, current_sum + weights[index], sol_len + 1);
    
    // Choice 2: Exclude the current element
    subset_sum(index + 1, current_sum, sol_len);
}

int main() {
    if (scanf("%d", &n) != 1) return 0;
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &weights[i]) != 1) return 0;
    }
    if (scanf("%d", &target) != 1) return 0;
    
    subset_sum(0, 0, 0);
    
    if (sol_count == 0) {
        printf("-1");
    } else {
        for (int i = sol_count - 1; i >= 0; i--) {
            for (int j = 0; j < stored_lens[i]; j++) {
                // Print a space after every element
                printf("%d ", stored_sols[i][j]);
            }
            // Print a newline ONLY if it is not the very last subset line
            if (i > 0) {
                printf("\n");
            }
        }
    }
    
    return 0;
}
